{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    // WXT 0.21's base config turns these on; the codebase predates them.
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2025",
    "verbatimModuleSyntax": false,
    "paths": {
      "@vitejs/plugin-react": ["./.types-shims/vitejs-plugin-react.d.ts"],
      "@zillions/components": ["./src/packages/components/src"],
      "@zillions/components/*": ["./src/packages/components/src/*"],
      "@zillions/storage": ["./src/packages/storage/src"],
      "@zillions/storage/*": ["./src/packages/storage/src/*"],
      "@zillions/types": ["./src/packages/types/src"],
      "@zillions/types/*": ["./src/packages/types/src/*"],
      "@zillions/utils": ["./src/packages/utils/src"],
      "@zillions/utils/*": ["./src/packages/utils/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "entrypoints/**/*", ".wxt/**/*"],
  "exclude": ["node_modules", ".output", ".wxt/dev-profile"]
}
