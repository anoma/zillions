VITE_GRPC_URL=https://zcash-mainnet.chainsafe.dev
VITE_INDEXER_URL=https://zcrawler.dev.heliax.app/api/v1
VITE_ZCASH_NETWORK=main
# Every sync phase on every core, hidden tab or not.
# VITE_ALLOW_CPU_TO_FRY=true
# Dev server only: prove sends but never broadcast them (nothing is spent).
# VITE_DRY_RUN=true
# Dev server only: migrations plan 0.001/0.002 ZEC amounts, to try preparations
# with little Orchard. Not ZIP 318's amounts: they don't blend in, and their
# transfers never send (docs/design/migration.md, Testing).
# VITE_MIGRATION_TEST_AMOUNTS=true
# Trial-decrypt on the CPU only, even with a usable GPU (to compare).
# VITE_GPU_DISABLED=true
