    "dexie-react-hooks": "^4.4.0",
    "idb": "^8.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0",
    "react-qr-code": "^2.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
