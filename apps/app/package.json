    "dexie": "4.4.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
    "react-qr-code": "2.2.0",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
