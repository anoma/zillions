    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "catalog:",
    "vite": "8.1.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
