default:
    just --list

build:
    just build-wallet
    just build-keys
    just build-requests
    just build-sapling-params

build-mac:
    #!/usr/bin/env bash
    export LLVM_PREFIX=$(brew --prefix llvm)
    export CC="$LLVM_PREFIX/bin/clang"
    export AR="$LLVM_PREFIX/bin/llvm-ar"
    export PATH="$LLVM_PREFIX/bin:$(brew --prefix binaryen)/bin:$PATH"
    just build

pack:
    #!/usr/bin/env bash
    mkdir -p dist
    for pkg in zillions-sdk-wallet zillions-sdk-keys zillions-sdk-requests zillions-sdk-sapling-params; do
        tarball=$(cd packages/$pkg && npm pack 2>/dev/null | tail -1)
        mv packages/$pkg/$tarball dist/
        echo "✓ dist/$tarball"
    done

ship-mac:
    just build-mac
    just pack

build-wallet *features:
    cd crates/zillions-sdk-wallet && wasm-pack build -t web --release --scope zillions-sdk --out-dir ../../packages/zillions-sdk-wallet --no-default-features --features="wasm wasm-parallel {{features}}" -Z build-std="panic_abort,std"
    ./add-worker-module.sh
    node patch-workers.js
    cp js/vite-plugin.js packages/zillions-sdk-wallet/
    cp js/vite-plugin.d.ts packages/zillions-sdk-wallet/
    cp js/params.js packages/zillions-sdk-wallet/
    cp js/params.d.ts packages/zillions-sdk-wallet/
    cp js/wallet-package.json packages/zillions-sdk-wallet/package.json
    rm -f packages/zillions-sdk-wallet/.gitignore

# Assemble the (immutable) Sapling proving params into their own npm package
build-sapling-params:
    ./scripts/assemble-sapling-params.sh
    cp js/sapling-params-package.json packages/zillions-sdk-sapling-params/package.json
    cp js/sapling-params-README.md packages/zillions-sdk-sapling-params/README.md
    rm -f packages/zillions-sdk-sapling-params/.gitignore

build-keys *features:
    cd crates/zillions-sdk-keys && wasm-pack build -t web --release --scope zillions-sdk --out-dir ../../packages/zillions-sdk-keys --no-default-features --features="{{features}}" -Z build-std="panic_abort,std"
    cp js/keys-package.json packages/zillions-sdk-keys/package.json
    rm -f packages/zillions-sdk-keys/.gitignore


build-requests *features:
    cd crates/zillions-sdk-requests && wasm-pack build -t web --release --scope zillions-sdk --out-dir ../../packages/zillions-sdk-requests --no-default-features --features="{{features}}" -Z build-std="panic_abort,std"
    cp js/requests-package.json packages/zillions-sdk-requests/package.json
    rm -f packages/zillions-sdk-requests/.gitignore

# All Wasm Tests
test-web *features:
    WASM_BINDGEN_TEST_TIMEOUT=99999 wasm-pack test --release --firefox --no-default-features --features "wasm no-bundler {{features}}" -Z build-std="panic_abort,std"

# sync message board in the web: addigional args:
test-message-board-web *features:
    WASM_BINDGEN_TEST_TIMEOUT=99999 wasm-pack test --release --chrome --no-default-features --features "wasm no-bundler {{features}}" -Z build-std="panic_abort,std" --test message-board-sync

# simple example in the web: additional args:
test-simple-web *features:
    WASM_BINDGEN_TEST_TIMEOUT=99999 wasm-pack test --release --chrome --no-default-features --features "wasm no-bundler {{features}}" -Z build-std="panic_abort,std" --test simple-sync-and-send

# simple example: additional args:, sqlite-db
example-simple *features:
   RUST_LOG="info,zcash_client_backend::sync=debug" cargo run -r --example simple-sync --features "native {{features}}"

# sync the message board: additional args:, sqlite-db
example-message-board *features:
  RUST_LOG=info,zcash_client_backend::sync=debug cargo run -r --example message-board-sync --features "native {{features}}"

alias c := check

check:
    cargo check

lint:
    cargo clippy

alias cw := check-wasm

check-wasm:
    cargo check --no-default-features --features="wasm-parallel,no-bundler" --target=wasm32-unknown-unknown

# run a local proxy to the mainnet lightwalletd server on port 443
run-proxy:
    grpcwebproxy  --backend_max_call_recv_msg_size=10485760 --server_http_max_write_timeout=1000s --server_http_max_read_timeout=1000s \
    --backend_addr=zec.rocks:443 --run_tls_server=false --backend_tls --allow_all_origins --server_http_debug_port 443
# run a local proxy to the testnet lightwalletd server on port 443
run-test-proxy:
    grpcwebproxy  --backend_max_call_recv_msg_size=10485760 --server_http_max_write_timeout=1000s --server_http_max_read_timeout=1000s \
    --backend_addr=testnet.zec.rocks:443 --run_tls_server=false --backend_tls --allow_all_origins --server_http_debug_port 443
