{
  "name": "zillions-interface",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "bash scripts/bootstrap.sh",
    "app": "pnpm --filter zillions-app",
    "app:add": "pnpm --filter zillions-app add",
    "app:remove": "pnpm --filter zillions-app remove",
    "app:dev": "pnpm --filter zillions-app dev",
    "app:build": "pnpm --filter zillions-app build",
    "app:preview": "pnpm --filter zillions-app preview",
    "app:lint": "pnpm --filter zillions-app lint",
    "app:typecheck": "pnpm --filter zillions-app typecheck",
    "app:test": "pnpm --filter zillions-app test",
    "app:e2e": "pnpm --filter zillions-app e2e",
    "keychain": "pnpm --filter zillions-keychain",
    "keychain:add": "pnpm --filter zillions-keychain add",
    "keychain:remove": "pnpm --filter zillions-keychain remove",
    "keychain:dev": "pnpm --filter zillions-keychain dev",
    "keychain:firefox:dev": "pnpm --filter zillions-keychain firefox:dev",
    "keychain:build": "pnpm --filter zillions-keychain build",
    "keychain:zip": "pnpm --filter zillions-keychain zip",
    "keychain:lint": "pnpm --filter zillions-keychain lint",
    "keychain:typecheck": "pnpm --filter zillions-keychain compile",
    "keychain:test": "pnpm --filter zillions-keychain test",
    "keychain:dapp": "pnpm --filter @zillions/test-dapp dev",
    "dev": "pnpm --parallel --filter zillions-app --filter zillions-keychain dev",
    "build": "bash scripts/build.sh",
    "zcore:build": "packages/zcore/build.sh",
    "typecheck": "pnpm app:typecheck && pnpm keychain:typecheck",
    "lint": "pnpm app:lint && pnpm keychain:lint",
    "test": "pnpm app:test && pnpm keychain:test",
    "format:check": "pnpm --filter zillions-app format:check"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.1"
  }
}
